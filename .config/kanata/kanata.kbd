;; Configuração básica para Windows
(defcfg
  ;; Garante que teclas não listadas no defsrc passem direto pelo Kanata
  process-unmapped-keys yes 
)

;; O defsrc define quais teclas o Kanata vai monitorar.
(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc  prtsc scrlck pause
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \     ins   home   pgup
  caps a    s    d    f    g    h    j    k    l    ;    '    ret        del   end    pgdn
  lsft z    x    c    v    b    n    m    ,    .    /    rsft               up
  lctl lmet lalt           spc            ralt rmet rctl          left  down  right
)

(defalias

  vim (tap-hold 200 200 esc (layer-while-held vim-mode))
)

;; O primeiro deflayer define o comportamento inicial.
;; O símbolo "_" (underscore) diz ao Kanata para usar a tecla padrão do defsrc.
(deflayer base
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _     _     _      _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _     _     _      _
  @vim _    _    _    _    _    _    _    _    _    _    _    _          _     _      _
  _    _    _    _    _    _    _    _    _    _    _    _               _
  _    _    _              _              _    _    _           _     _      _
)

(deflayer vim-mode
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _     _     _      _
  _    _  C-rght _    _    _    _    _   home  _    _    _    _    _     _     _      _
  _   end   _    _    _    _  left  down  up  rght  _    _    _          _     _      _
  _    _    _    _    _  C-left _    _    _    _    _    _               _
  _    _    _              _              _    _    _           _     _      _
)
