#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

TICK="${GREEN}[OK]${NC}"
CROSS="${RED}[ERROR]${NC}"
WARN="${YELLOW}[WARN]${NC}"
INFO="${BLUE}[INFO]${NC}"

SSH_DIR="$HOME/.ssh"
SSH_CONFIG="$SSH_DIR/config"
MOUNT_BASE="$HOME/servers"

print_header() {
    echo -e "${BOLD}${BLUE}sshm${NC} - SSH Connection and Filesystem Manager"
    echo -e "${BLUE}---------------------------------------------${NC}"
}

check_dependencies() {
    local missing_deps=()

    for cmd in fzf sshfs; do
        if ! command -v "$cmd" &> /dev/null; then
            missing_deps+=("$cmd")
        fi
    done

    if [ ${#missing_deps[@]} -ne 0 ]; then
        echo -e "${CROSS} Missing required dependencies: ${RED}${missing_deps[*]}${NC}"
        echo -e "${INFO} Install them with your system package manager, for example: sudo pacman -S fzf sshfs"
        exit 1
    fi
}

get_ssh_hosts() {
    [ -f "$SSH_CONFIG" ] || return 0
    awk '/^[[:space:]]*Host[[:space:]]+/ { for (i = 2; i <= NF; i++) if ($i != "*") print $i }' "$SSH_CONFIG"
}

prompt_yes_no() {
    local prompt="$1"
    local answer

    read -rp "$prompt [y/N] " answer
    [[ "$answer" =~ ^[Yy]$ ]]
}

ensure_ssh_config() {
    if [ ! -d "$SSH_DIR" ]; then
        mkdir -p "$SSH_DIR"
        chmod 700 "$SSH_DIR"
        echo -e "${TICK} Created ${GREEN}$SSH_DIR${NC}." >&2
    fi

    if [ ! -f "$SSH_CONFIG" ]; then
        touch "$SSH_CONFIG"
        chmod 600 "$SSH_CONFIG"
        echo -e "${TICK} Created ${GREEN}$SSH_CONFIG${NC}." >&2
    fi
}

read_required_value() {
    local prompt="$1"
    local value

    while true; do
        read -rp "$prompt" value
        if [ -n "$value" ]; then
            printf '%s' "$value"
            return 0
        fi
        echo -e "${WARN} This field is required." >&2
    done
}

add_ssh_host() {
    local host_alias host_name ssh_user ssh_port identity_file

    ensure_ssh_config

    echo >&2
    echo -e "${INFO} Add a new SSH host. Leave optional fields blank to skip them." >&2

    host_alias=$(read_required_value "Host alias: ")
    host_name=$(read_required_value "HostName or IP: ")

    read -rp "User [$USER]: " ssh_user
    ssh_user=${ssh_user:-$USER}

    read -rp "Port [22]: " ssh_port
    ssh_port=${ssh_port:-22}

    read -erp "IdentityFile (optional): " identity_file
    identity_file=${identity_file/#\~/$HOME}

    {
        printf '\nHost %s\n' "$host_alias"
        printf '    HostName %s\n' "$host_name"
        printf '    User %s\n' "$ssh_user"
        printf '    Port %s\n' "$ssh_port"
        if [ -n "$identity_file" ]; then
            printf '    IdentityFile %s\n' "$identity_file"
        fi
    } >> "$SSH_CONFIG"

    chmod 600 "$SSH_CONFIG"
    echo -e "${TICK} Host ${GREEN}$host_alias${NC} saved to ${GREEN}$SSH_CONFIG${NC}." >&2
}

select_host() {
    local hosts

    hosts=$(get_ssh_hosts)
    while [ -z "$hosts" ]; do
        echo -e "${WARN} No SSH hosts found in ${YELLOW}$SSH_CONFIG${NC}." >&2
        if prompt_yes_no "Add a host now?"; then
            add_ssh_host
            hosts=$(get_ssh_hosts)
        else
            echo "No host configured. Exiting." >&2
            exit 0
        fi
    done

    printf '%s\n' "$hosts" | fzf --height=30% --reverse --border --prompt="Select SSH host > "
}

select_mount_base() {
    local custom_mount_base

    if [ -d "$MOUNT_BASE" ]; then
        printf '%s' "$MOUNT_BASE"
        return 0
    fi

    echo -e "${WARN} Mount directory ${YELLOW}$MOUNT_BASE${NC} not found." >&2
    if prompt_yes_no "Create it now?"; then
        mkdir -p "$MOUNT_BASE"
        echo -e "${TICK} Directory created." >&2
        printf '%s' "$MOUNT_BASE"
        return 0
    fi

    while true; do
        read -erp "Enter a writable directory for SSHFS mounts: " custom_mount_base
        custom_mount_base=${custom_mount_base/#\~/$HOME}

        if [ -d "$custom_mount_base" ] && [ -w "$custom_mount_base" ]; then
            echo -e "${TICK} Using ${GREEN}$custom_mount_base${NC} for mounts." >&2
            printf '%s' "$custom_mount_base"
            return 0
        fi

        echo -e "${CROSS} Directory ${RED}$custom_mount_base${NC} is not valid or not writable." >&2
    done
}

mount_host() {
    local selected_host="$1"
    local mount_point="$2"

    if mountpoint -q "$mount_point"; then
        echo -e "${WARN} Already mounted at ${YELLOW}$mount_point${NC}."
        return 0
    fi

    mkdir -p "$mount_point"
    if sshfs "$selected_host":/ "$mount_point" -o reconnect,ServerAliveInterval=15,ServerAliveCountMax=3; then
        echo -e "${TICK} Host mounted at ${GREEN}$mount_point${NC}."
        return 0
    fi

    echo -e "${CROSS} Failed to mount host. Check permissions or SSH connectivity."
    rmdir "$mount_point" 2> /dev/null
    return 1
}

unmount_host() {
    local mount_point="$1"

    if ! mountpoint -q "$mount_point"; then
        echo -e "${WARN} Not currently mounted at ${YELLOW}$mount_point${NC}."
        return 0
    fi

    if umount "$mount_point"; then
        echo -e "${TICK} Unmounted successfully."
        return 0
    fi

    echo -e "${CROSS} Failed to unmount. The mount may be in use."
    return 1
}

main() {
    local selected_host mount_point_base mount_point action

    print_header
    check_dependencies

    selected_host=$(select_host)
    if [ -z "$selected_host" ]; then
        echo "No host selected. Exiting."
        exit 0
    fi

    mount_point_base=$(select_mount_base)
    mount_point="$mount_point_base/$selected_host"

    action=$(printf "Connect and mount\nConnect with SSH only\nMount with SSHFS only\nUnmount" | fzf --height=30% --reverse --border --prompt="Action for '$selected_host' > ")

    case "$action" in
        "Connect and mount")
            mount_host "$selected_host" "$mount_point" || exit 1
            echo -e "${INFO} Opening SSH connection..."
            ssh "$selected_host"

            if mountpoint -q "$mount_point" && prompt_yes_no "Disconnect detected. Unmount from $mount_point?"; then
                unmount_host "$mount_point"
            fi
            ;;
        "Connect with SSH only")
            ssh "$selected_host"
            ;;
        "Mount with SSHFS only")
            mount_host "$selected_host" "$mount_point"
            ;;
        "Unmount")
            unmount_host "$mount_point"
            ;;
        *)
            echo "No action selected. Exiting."
            ;;
    esac
}

main
